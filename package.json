{
  "name": "tgz-lol",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "predev": "tsx scripts/generate-tailwind-safelist.ts || true",
    "dev:resilient": "nodemon --config nodemon.dev.json",
    "build": "next build",
    "prebuild": "tsx scripts/generate-tailwind-safelist.ts || true",
    "postbuild": "tsx scripts/deploy-components.ts || true && mkdir -p .next/standalone/.next && cp -r .next/static .next/standalone/.next/ 2>/dev/null || true",
    "start": "next start",
    "start:standalone": "node .next/standalone/server.js",
    "start:watch": "nodemon --config nodemon.start.json",
    "lint": "eslint .",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:status": "docker compose ps | cat",
    "drizzle:generate": "drizzle-kit generate",
    "drizzle:migrate": "drizzle-kit migrate",
    "drizzle:studio": "drizzle-kit studio --port 4983",
    "sync:components": "tsx scripts/component-sync.ts",
    "components:status": "tsx scripts/component-sync.ts status",
    "components:push": "tsx scripts/component-sync.ts push",
    "components:version": "tsx scripts/component-sync.ts version",
    "components:init": "tsx scripts/component-sync.ts init",
    "deploy:components": "tsx scripts/deploy-components.ts",
    "setup:production": "tsx scripts/production-setup.ts",
    "check:tools": "node scripts/check-tools.js",
    "tailwind:safelist": "tsx scripts/generate-tailwind-safelist.ts",
    "reprocess:components": "tsx scripts/reprocess-post-components.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@mdx-js/mdx": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@types/mdast": "^4.0.4",
    "better-auth": "^1.3.9",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "dotenv": "^17.2.2",
    "drizzle-kit": "^0.31.4",
    "drizzle-orm": "^0.44.5",
    "katex": "^0.16.22",
    "lucide-react": "^0.542.0",
    "motion": "^12.23.12",
    "nanoid": "^5.1.5",
    "next": "15.5.0",
    "pg": "^8.16.3",
    "postgres": "^3.4.7",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.3.1",
    "tsx": "^4.20.5",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.0.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/typography": "^0.5.16",
    "@types/node": "^20",
    "@types/pg": "^8.15.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.0",
    "nodemon": "^3.1.10",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "type": "module"
}
